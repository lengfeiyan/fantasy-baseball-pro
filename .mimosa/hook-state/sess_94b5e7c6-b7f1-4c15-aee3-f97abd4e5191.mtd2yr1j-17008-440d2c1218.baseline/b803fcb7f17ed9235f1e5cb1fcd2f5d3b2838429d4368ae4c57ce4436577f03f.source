name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-22.04
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.9", "3.11"]
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      # GUI 测试需要虚拟显示（xvfb）；tkinter 随 setup-python 提供
      - name: 安装虚拟显示
        run: sudo apt-get update && sudo apt-get install -y xvfb

      - name: 安装依赖
        run: |
          python -m pip install --upgrade pip
          pip install pandas pyyaml pytest
          # numba/requests 为可选加速/抓取依赖，CI 不安装（代码有降级路径）

      - name: 运行测试
        env:
          PYTHONPATH: src
        run: xvfb-run -a python -m pytest tests/ -q
